# FinBridge Environment Variables
# Copy this file to .env.local and fill in your values

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/finbridge"

# ── Authentication ────────────────────────────────────────
JWT_SECRET="your-long-random-secret-here"

# ── AI Providers ──────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# ── Google OAuth (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET="another-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (optional — defaults to console logging) ────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@finbridge.io"

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NODE_ENV="development"
